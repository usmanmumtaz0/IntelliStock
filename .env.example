APP_ENV=development

# Database: create a dedicated role and replace every placeholder locally.
# URL-encode special characters in the password.
POSTGRES_USER=intellistock
POSTGRES_PASSWORD=replace_locally_with_a_random_password
POSTGRES_DB=intellistock
DATABASE_URL=postgresql://intellistock:replace_locally_with_a_url_encoded_password@localhost:5432/intellistock
DATABASE_URL_DOCKER=postgresql://intellistock:replace_locally_with_a_url_encoded_password@postgres:5432/intellistock

# Redis (local development)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1

# JWT
# Generate locally, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_locally_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Rate limiting
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
TRUSTED_PROXY_HEADERS=false

# Optional inputs for `python -m scripts.create_admin`. Prefer interactive password entry.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (these values are baked into the browser bundle at build time)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/inventory

# Logging
LOG_LEVEL=INFO
ALERT_COOLDOWN_SECONDS=300
ALERT_ESCALATION_SECONDS=900

# Trained model integration (leave blank until training is finalized).
# Use an absolute path, for example C:/IntelliStock/models/best.pt
# Never substitute generic weights for a SKU-trained model.
CV_MODEL_PATH=
# Reviewed JSON identity/class-to-SKU manifest; required by the vision worker.
CV_MODEL_MANIFEST=
CV_DEVICE=cpu

# Server-side integrations. Email and AI provider calls are opt-in; SMS remains pending.
# Server-side only. NEVER put passwords or API keys in VITE_* variables.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Supported: local, openai, openrouter. Each remote provider uses its own key above.
CHAT_PROVIDER=local
# Exact provider model ID with structured-output support; OpenRouter example: google/gemini-2.5-flash
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=15
CHAT_MAX_TURNS=100
CHAT_REQUESTS_PER_MINUTE=10
SMTP_PASSWORD=
TWILIO_AUTH_TOKEN=

# External email stays disabled. Set only an explicitly approved recipient.
NOTIFICATIONS_ENABLED=false
# One to 20 comma-separated approved addresses; each gets separate delivery/retries.
NOTIFICATION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
