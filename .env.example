APP_ENV=development

# Database: create a dedicated role and replace every placeholder locally.
# URL-encode special characters in the password.
POSTGRES_USER=intellistock
POSTGRES_PASSWORD=replace_locally_with_a_random_password
POSTGRES_DB=intellistock
DATABASE_URL=postgresql://intellistock:replace_locally_with_a_url_encoded_password@localhost:5432/intellistock
DATABASE_URL_DOCKER=postgresql://intellistock:replace_locally_with_a_url_encoded_password@postgres:5432/intellistock

# Redis (local development)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1

# JWT
# Generate locally, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_locally_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Rate limiting
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
TRUSTED_PROXY_HEADERS=false

# Optional inputs for `python -m scripts.create_admin`. Prefer interactive password entry.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Frontend (these values are baked into the browser bundle at build time)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/inventory

# Logging
LOG_LEVEL=INFO
ALERT_COOLDOWN_SECONDS=300
ALERT_ESCALATION_SECONDS=900

# Trained model integration (leave blank until training is finalized).
# Use an absolute path, for example C:/IntelliStock/models/best.pt
# Never substitute generic weights for a SKU-trained model.
CV_MODEL_PATH=
# Reviewed JSON identity/class-to-SKU manifest. Empty SKU mappings remain review-only.
# Use an absolute path, for example C:/IntelliStock/models/model-manifest.json
CV_MODEL_MANIFEST=
CV_DETECTOR=yolov8
# auto selects CUDA only when the installed PyTorch build can use it.
CV_DEVICE=auto
CV_CONFIDENCE_THRESHOLD=0.40
CV_IMAGE_SIZE=640
CV_NMS_IOU_THRESHOLD=0.45
CV_MAX_DETECTIONS=300
CV_IDENTITY_MIN_CONFIDENCE=0.65
# Pretrained identity dependencies are installed by the main backend requirements.
# OCR may download its selected pretrained model during explicit setup/first load.
CV_OCR_ENABLED=false
CV_OCR_LANGUAGE=en
CV_OCR_VERSION=PP-OCRv6
CV_OCR_DEVICE=cpu
CV_OCR_MIN_CONFIDENCE=0.55
CV_OCR_MATCH_MIN_CONFIDENCE=0.72
CV_OCR_MATCH_MIN_MARGIN=0.10
# DINOv2 is local-only at runtime. Stage a Hugging Face model directory explicitly.
CV_EMBEDDING_ENABLED=false
CV_EMBEDDING_MODEL_PATH=
CV_EMBEDDING_DEVICE=cpu
CV_REFERENCE_IMAGE_ROOT=backend/media/product-references
CV_RETRIEVAL_MIN_CONFIDENCE=0.82
CV_RETRIEVAL_MIN_MARGIN=0.05
CV_MAX_REFERENCE_IMAGES=500
CV_EVIDENCE_REFRESH_SHARPNESS_RATIO=1.20
CV_IDENTITY_CACHE_ROOT=backend/media/model-cache
VIDEO_STORAGE_ROOT=backend/media/video-jobs
VIDEO_MAX_UPLOAD_BYTES=524288000
IMAGE_MAX_UPLOAD_BYTES=26214400
VIDEO_MAX_FRAMES=300
VIDEO_MAX_DURATION_SECONDS=900
VIDEO_PREVIEW_FRAMES=12
VIDEO_WORKER_POLL_SECONDS=1.0
# Comma-separated hostnames/IPs that bounded camera jobs may connect to.
VIDEO_ALLOWED_CAMERA_HOSTS=127.0.0.1,localhost

# Server-side integrations. Email and AI provider calls are opt-in; SMS remains pending.
# Server-side only. NEVER put passwords or API keys in VITE_* variables.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Supported: local, openai, openrouter. Each remote provider uses its own key above.
CHAT_PROVIDER=local
# Exact provider model ID with structured-output support; OpenRouter example: google/gemini-2.5-flash
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=15
CHAT_MAX_TURNS=100
CHAT_REQUESTS_PER_MINUTE=10
SMTP_PASSWORD=
TWILIO_AUTH_TOKEN=

# External email stays disabled. Set only an explicitly approved recipient.
NOTIFICATIONS_ENABLED=false
# One to 20 comma-separated approved addresses; each gets separate delivery/retries.
NOTIFICATION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
