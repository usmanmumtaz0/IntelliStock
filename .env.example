# Database (local development)
# Format: postgresql://username:password@host:port/database
# For special characters in password, URL-encode them (e.g., # becomes %23)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/intellistock

# Redis (local development)
REDIS_URL=redis://localhost:6379/0

# JWT
# IMPORTANT: Change this in production to a strong random string
JWT_SECRET=local-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API
API_HOST=localhost
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=DEBUG
