APP_ENV=development

# Database: create a dedicated role and replace every placeholder locally.
# URL-encode special characters in the password.
POSTGRES_USER=intellistock
POSTGRES_PASSWORD=replace_locally_with_a_random_password
POSTGRES_DB=intellistock
DATABASE_URL=postgresql://intellistock:replace_locally_with_a_url_encoded_password@localhost:5432/intellistock
DATABASE_URL_DOCKER=postgresql://intellistock:replace_locally_with_a_url_encoded_password@postgres:5432/intellistock

# Redis (local development)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1

# JWT
# Generate locally, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_locally_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Rate limiting
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
TRUSTED_PROXY_HEADERS=false

# Optional inputs for `python -m scripts.create_admin`. Prefer interactive password entry.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
