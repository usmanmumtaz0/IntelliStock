# Database (local development)
# Note: Update password to match your PostgreSQL installation
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellistock

# Redis (local development)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-secret-key-here-change-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO
